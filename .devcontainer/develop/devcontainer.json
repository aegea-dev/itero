// To work on itero: build it, test it, check its model and docs. The Rust
// version comes from rust-toolchain.toml, as everywhere else.
{
  "name": "itero: develop",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {},
    // the docs (Yarn through corepack), at docs/.node-version's Node
    "ghcr.io/devcontainers/features/node:1": { "version": "24.11.1" },
    // make test-docker and make model
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "containerEnv": {
    "ITERO_NO_SECRET_STORE": "1"
  },
  "postCreateCommand": "sh .devcontainer/develop/setup.sh"
}
