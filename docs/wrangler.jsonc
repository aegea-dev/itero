{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "itero-doc",
	"compatibility_date": "2026-08-11",
	// A static site, so there is no `main` entry point: this is an assets-only
	// Worker. Cloudflare serves the built files directly, with no script running
	// on the request path.
	"assets": {
		// Relative to this file, and the dashboard's root directory is `docs`,
		// so this is the `dist/` that `yarn build` writes.
		"directory": "./dist",
		// Serve Starlight's generated 404.html for unknown paths, instead of a
		// bare Cloudflare error page.
		"not_found_handling": "404-page"
	},
	// Required, even empty, for `wrangler preview`, the deploy command for
	// non-production branches. Assets and compatibility settings above apply to
	// Previews too.
	"previews": {}
}