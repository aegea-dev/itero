#!/bin/sh
# Is $order paid? A real one asks the payment provider with curl. A
# pending payment comes back later as a payment.received event with the
# same payment_ref as this step printed: then this step runs again, with
# that event's data in $event.
paid=$(printf '%s' "${event:-}" | jq '.paid | values')
[ -n "$paid" ] && { echo "{\"paid\": $paid}"; exit 0; }
# the provider said "pending": wait for its event
echo "{\"payment_ref\": \"pay-$order\"}"
exit 75
