#!/bin/sh
# How $order went: done, failed and $why, or the step that broke
# ($failed_step).
if [ -n "$failed_step" ]; then
  echo "order $order: error at $failed_step: $why" >> .itero/results.log
elif [ -n "$why" ]; then
  echo "order $order: failed: $why" >> .itero/results.log
else
  echo "order $order: done" >> .itero/results.log
fi
