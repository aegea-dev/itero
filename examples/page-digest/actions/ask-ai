#!/bin/sh
# Asks an AI assistant (Anthropic's API) $prompt about $page: {"text": ...}.
# The key goes to curl on stdin, never on its command line.
body=$(mktemp) || exit 1
trap 'rm -f "$body"' EXIT
jq -n --arg q "$prompt

$page" '{model: "claude-sonnet-5-5", max_tokens: 1024,
          messages: [{role: "user", content: $q}]}' > "$body"
printf 'header = "x-api-key: %s"\n' "$key" |
  curl -fsS --max-time 120 -K - https://api.anthropic.com/v1/messages \
    -H 'anthropic-version: 2023-06-01' -H 'content-type: application/json' \
    --data-binary @"$body" |
  jq '{text: .content[0].text}'
