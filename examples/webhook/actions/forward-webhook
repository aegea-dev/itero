#!/bin/sh
# A message from the app comes here, once: the workflow's on lets each id
# through once, so a service sending again after a failed delivery starts
# nothing. It picks the fields it trusts and sends an event of its own.
# The body is a stranger's text: never eval it.
jq -c '.args.body | {from: (.from | tostring), text: (.text | tostring)}' |
  itero ws emit app.message.received --file -
