{
  "on": [{ "event": "gmail.received",
            "args": { "user": "me@gmail.com", "password": "$$GMAIL_PASS" } }],
  "steps": [{ "#notify": { "args": {
    "title": "Gmail", "subtitle": "$event.from", "text": "$event.subject",
    "url": "$event.url", "data": "$event.data", "sound": "default"
  } } }]
}
