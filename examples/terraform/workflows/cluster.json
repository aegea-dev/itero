{
  "on": [{ "event": "cluster.requested" }, { "has": "$name" }],
  "steps": [
    { "#cluster-create": { "undo": "#cluster-delete" } },
    "#tf-plan",
    "#check-plan",
    "#tf-apply",
    "#web-check"
  ],
  "error": [
    { "#notify": { "title": "$name", "text": "$why" } },
    { "#notify": { "on": [{ "has": "$undo_failed" }], "title": "$name is left", "text": "$undo_failed" } }
  ]
}
