{
  "on": [{ "event": "cluster.requested" }, { "has": "$name" }],
  "steps": [
    { "#cluster-create": { "undo": "#cluster-delete" } },
    { "#tf-plan": { "args": "$output" } },
    "#check-plan",
    "#tf-apply",
    "#web-check"
  ],
  "error": [
    { "#notify": { "args": { "title": "$name", "text": "$why" } } },
    { "#notify": { "on": [{ "has": "$undo_failed" }],
                   "args": { "title": "$name is left", "text": "$undo_failed" } } }
  ]
}
