{
  "meta": { "description": "A 3-machine k3d cluster with a web app, applied with OpenTofu" },
  "on": [{ "event": "cluster.requested" }, { "has": "$name" }],
  "steps": [
    { "#cluster-create": { "undo": "#cluster-delete" } },
    "#tf-plan",
    "#check-plan",
    "#tf-apply",
    "#web-check"
  ]
}
