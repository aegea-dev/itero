#!/bin/sh
# A guard between the plan and the apply: the run stops before anything
# changes when $plan (#tf-plan's result) destroys something, or adds more
# than $max_add resources (10 unless given).
set -eu
plan=$(jq -c '.args.plan')
max=${max_add:-10}
if ! printf '%s' "$plan" | jq -e --argjson max "$max" \
  '.destroy == 0 and .add <= $max' >/dev/null; then
  echo "the plan is refused: $plan, at most $max to add and none to destroy" >&2
  exit 1
fi
echo '{"plan_checked": true}'
