{
  "on": [{ "schedule": "* * * * *" }],
  "steps": [
    { "#check-sites": { "args": { "sites": ["https://example.com", "http://localhost:3000"] } } },
    { "#changed": { "args": { "now": "$output" } } },
    { "#notify": { "on": [{ "has": "$output.text" }],
                  "args": { "title": "beacon: sites", "text": "$output.text" } } }
  ]
}
