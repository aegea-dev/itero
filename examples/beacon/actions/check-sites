#!/bin/sh
# Each site in $sites (a JSON list, the workflow's setting), up or down:
# {"status": {"<url>": "up"}}. set -e: a jq that fails inside $(...)
# ends it, rather than leaving no sites to check.
set -e
urls=$(printf '%s' "${sites:-[]}" | jq -r '.[]')
status='{}'
for url in $urls; do
  if curl -fsS --max-time 10 -o /dev/null "$url" 2>/dev/null; then
    s=up
  else
    s=down
  fi
  status=$(printf '%s' "$status" | jq -c --arg u "$url" --arg s "$s" '. + {($u): $s}')
done
printf '{"status": %s}\n' "$status"
