#!/bin/sh
# Each site in sites.txt, up or down: {"status": {"<url>": "up"}}.
status='{}'
while read -r url; do
  case "$url" in '' | '#'*) continue ;; esac
  if curl -fsS --max-time 10 -o /dev/null "$url" 2>/dev/null; then
    s=up
  else
    s=down
  fi
  status=$(printf '%s' "$status" | jq -c --arg u "$url" --arg s "$s" '. + {($u): $s}')
done < sites.txt
printf '{"status": %s}\n' "$status"
