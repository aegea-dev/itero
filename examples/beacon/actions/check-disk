#!/bin/sh
# The disk this folder is on: "ok", or low under $min_free percent free
# (10 unless its step says).
min_free=${min_free:-10}
used=$(df -P . | awk 'NR == 2 { sub("%", "", $5); print $5 }')
if [ $((100 - used)) -lt "$min_free" ]; then
  s="under $min_free% free"
else
  s=ok
fi
jq -cn --arg s "$s" '{status: {disk: $s}}'
