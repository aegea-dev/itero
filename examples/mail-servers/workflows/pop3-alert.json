{
  "on": [{ "schedule": "* * * * *" }],
  "steps": [
    { "#pop3-check": { "args": { "host": "pop.example.com", "port": 995, "tls": true,
                                 "user": "me@example.com", "password": "$$POP3_PASS" },
                       "strict": true } },
    { "#notify": { "on": [{ "has": "$output.text" }], "args": "$output" } }
  ]
}
