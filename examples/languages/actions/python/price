#!/usr/bin/env python3
"""The order, its arg, priced: {"total": ..., "tax": ...} with 20% tax.

Plain Python, no packages; it runs warm in the order-flow workflow,
between a Bun step and a Node one.
"""
import json
import sys

order = json.load(sys.stdin)["args"]["order"]
tax = round(order["total"] * 0.20, 2)
print(json.dumps({"total": round(order["total"] + tax, 2), "tax": tax}))
