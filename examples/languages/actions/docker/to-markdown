#!/bin/sh
# The page's HTML, its arg $page, as Markdown by pandoc in Docker: at most
# 20000 characters, for a model to read. Docker pulls pandoc/minimal (about
# 30 MB) the first time. The page is read from stdin: a big one is not in
# the environment.
set -eu
jq -r '.args.page' |
  docker run --rm -i pandoc/minimal:3.11.0 -f html -t gfm-raw_html --wrap=none |
  jq -Rrs '.[0:20000]'
