{
  "on": [{ "event": "website.summarize" }, { "has": "$event.url" }],
  "steps": [
    { "#fetch": { "args": { "url": "$event.url" } } },
    { "#to-markdown": { "args": { "page": "$output" } } },
    { "#ask-ai": { "args": { "prompt": "Summarize this page in 5 bullets.",
                             "key": "$$LM_STUDIO_TOKEN", "page": "$output" } } }
  ],
  "success": [{ "#print": { "args": { "url": "$event.url", "text": "$output" } } }]
}
