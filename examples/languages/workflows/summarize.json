{
  "on": [{ "event": "website.summarize" }, { "has": "$url" }],
  "steps": [
    "#fetch",
    "#to-markdown",
    { "#ask-ai": { "args": { "prompt": "Summarize this page in 5 bullets.",
                             "key": "$$LM_STUDIO_TOKEN", "page": "$output" },
                   "strict": true } }
  ],
  "success": [{ "#print": { "args": { "text": "$output" } } }]
}
