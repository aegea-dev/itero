#!/bin/sh
# A delivery from GitHub comes here, once: the workflow's on lets each
# delivery id through once, so GitHub's Redeliver starts nothing. It picks
# the fields it trusts and sends an event of its own. A commit's message is
# a stranger's text: never eval it.
input=$(cat)
[ "$(printf '%s' "$input" | jq -r '.args.kind')" = push ] || exit 0

printf '%s' "$input" |
  jq -c '.args.body | {
    repository: .repository.full_name,
    branch: (.ref | ltrimstr("refs/heads/")),
    by: .pusher.name,
    commit: (.head_commit.message // "" | split("\n")[0])
  }' |
  itero ws emit github.pushed --file -
