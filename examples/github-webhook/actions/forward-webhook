#!/bin/sh
# Every webhook comes here. It picks the fields it trusts and sends an event
# of its own. A commit's message is a stranger's text: never eval it.
input=$(cat)
field() { printf '%s' "$input" | jq -r ".args.$1"; }
[ "$(field path)" = /github ] && [ "$(field kind)" = push ] || exit 0

# GitHub's Redeliver sends a delivery again: each one once. Kept as JSON, so
# it stays on one line whatever it holds.
id=$(printf '%s' "$input" | jq -c '.args.delivery')
touch "$ITERO_MEMORY"
grep -qxF -- "$id" "$ITERO_MEMORY" && exit 0
printf '%s\n' "$id" >>"$ITERO_MEMORY"

printf '%s' "$input" |
  jq -c '.args.body | {
    repository: .repository.full_name,
    branch: (.ref | ltrimstr("refs/heads/")),
    by: .pusher.name,
    commit: (.head_commit.message // "" | split("\n")[0])
  }' |
  itero ws emit github.pushed --file -
