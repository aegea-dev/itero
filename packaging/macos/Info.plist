<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Itero.app: gives itero's notifications their sender. It has no window
     and no Dock icon (LSUIElement); itero-notifier shows one notification
     and exits. -->
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>dev.aegea.itero.notifier</string>
  <key>CFBundleName</key>
  <string>itero</string>
  <key>CFBundleDisplayName</key>
  <string>itero</string>
  <key>CFBundleExecutable</key>
  <string>itero-notifier</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>0.1.0</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>LSUIElement</key>
  <true/>
</dict>
</plist>
